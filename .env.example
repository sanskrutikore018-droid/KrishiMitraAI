# Krishi Mitra AI - Environment Variables
# Copy this to backend/.env or set in your environment

# Google Gemini API Key (Google AI Studio - Free tier)
# Get yours at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Sarvam AI API Key (for Saarika STT and Bulbul TTS)
# Get yours at: https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional configuration
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000

